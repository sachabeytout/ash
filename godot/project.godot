; Projet Godot d'ASH (refonte en vraie 3D, voir docs/DECISIONS.md « Passage à Godot »).
; Godot 4.5.1. Ouvrir ce dossier dans Godot pour l'éditer.

config_version=5

[application]

config/name="ASH"
config/version="0.1.0"
run/main_scene="res://src/game/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.027, 0.024, 0.051, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
anti_aliasing/quality/msaa_3d=2
